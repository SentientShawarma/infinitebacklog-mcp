# Optional. Only the autonomous agent tool needs one of these.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
BROWSER_USE_API_KEY=

# Sign in from this file, or leave both blank and sign in once in the Playwright window.
# The login form asks for a username or email, then a password.
# The server types those two values into that form. It does not read a browser cookie file.
IB_USERNAME=
IB_PASSWORD=

# Optional overrides
# IB_HEADLESS=true
# IB_VIEWPORT_WIDTH=1280
# IB_VIEWPORT_HEIGHT=800

# Debug only. Allows the evaluate_js tool to run page JavaScript.
# IB_ALLOW_EVAL_JS=false

# Containers only. Do not enable on a desktop session.
# IB_CHROMIUM_NO_SANDBOX=false
